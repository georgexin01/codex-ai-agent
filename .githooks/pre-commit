#!/bin/sh

# A sparse worktree can hide protected directories and make `git add -A`
# silently skip their changes. Do not create commits from an incomplete view.
sparse_checkout=$(git config --bool --get core.sparseCheckout 2>/dev/null || printf 'false')
if test "$sparse_checkout" = "true"; then
  echo "ERROR: sparse-checkout is enabled for the .codex repository."
  echo "Disable it with 'git sparse-checkout disable' before staging or committing."
  exit 1
fi

# Protect durable Codex knowledge/configuration and active runtime lock directories.
protected_paths="automations codex-router mcp-oauth-locks memories rules skills tasks thread-writer-locks sessions rollout-migrations .claude .github .githooks"
deletions=$(git diff --cached --name-status --diff-filter=DR -- $protected_paths)
allowed_deletion=$(printf 'D\t%s' "automations/test/automation.toml")
blocked_deletions=$(
  printf '%s\n' "$deletions" |
    while IFS= read -r entry; do
      if test -n "$entry" && test "$entry" != "$allowed_deletion"; then
        printf '%s\n' "$entry"
      fi
    done
)
if test -n "$blocked_deletions"; then
  echo "ERROR: staged deletion or rename of protected Codex paths is blocked."
  echo "Restore the staged change. Only the approved test automation deletion is exempt."
  printf '%s\n' "$blocked_deletions"
  exit 1
fi

if git ls-files --stage -- memories | grep -q '^160000 '; then
  echo "ERROR: memories is staged as a nested Git repository (gitlink)."
  echo "Keep memories tracked as ordinary files in the root .codex repository."
  exit 1
fi

if test -e "memories/.git"; then
  echo "WARNING: preserving memories/.git; root index tracks memories as ordinary files."
fi

exit 0
