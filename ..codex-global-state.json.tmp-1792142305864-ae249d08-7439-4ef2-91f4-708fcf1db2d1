ionId` yet (a newly uploaded image, or you switched to a different one), set it to `-1`; a new handle is minted and returned — reuse that value for every later call on this image. Keep a `sessionId` per source image: returning to an earlier image reuses the handle from that image, not `-1`.","type":"string"}},"required":["imageURI"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false},"_meta":{"resource_name":"adobe.image_remove_blemishes","_codex_apps":{"resource_uri":"/connector_69312da8e4dc81919370cb86fd172b6c/link_6abb1a24e0d88191bee88b0fb41f697e/image_remove_blemishes","contains_mcp_source":true},"connector_id":"connector_69312da8e4dc81919370cb86fd172b6c","connector_name":"Adobe","connector_description":"Design, combine, and edit","link_id":"link_6abb1a24e0d88191bee88b0fb41f697e","link_owner_profile":{}},"outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"error":{"description":"If failed, error message from the tool result.","type":"string"},"input":{"description":"Original input parameters passed to the tool","type":"object","properties":{},"additionalProperties":{}},"metadata":{"description":"Optional metadata related to the tool result(s), will vary depending on the tool.","type":"object","properties":{},"additionalProperties":{}},"originalURI":{"description":"Original input image URI, if applicable.","type":"string"},"outputFile":{"description":"If tool succeeded, the file object for the processed image result.","type":"string"},"outputUrl":{"description":"If tool succeeded, presigned URL for the processed image result.","type":"string"},"outputMediaType":{"description":"If tool succeeded, IANA media type of the asset at `outputUrl` (e.g. \"image/png\", \"image/jpeg\"). Set when the tool knows the output format deterministically; clients should prefer this over inferring from the URL or following redirects.","type":"string"},"requestId":{"description":"Request ID for tracking and debugging.","type":"string"},"originRequestId":{"description":"Diagnostic id of the call that started a long-running operation; every poll of that operation reports the same value. Quote it when reporting a problem. NOT a `taskId` — never pass it to a tool.","type":"string"},"success":{"type":"boolean","description":"Whether the tool call was successful or not."},"importantNote":{"description":"Optional high-priority note for the assistant about this result: follow-up actions, caveats, or how to present or reuse the output.","type":"string"},"status":{"description":"Set to \"working\" when the operation is still running upstream and no output exists yet. The call did not fail — call the `image_get_task_status` tool with the returned `taskId` to wait for the result. Never present a \"working\" result to the user as a finished deliverable.","type":"string","const":"working"},"taskId":{"type":"string","description":"Opaque handle for an operation that is still running. Present when `status` is \"working\". Pass it verbatim to the `image_get_task_status` tool to wait for the result. Server-generated and meaningless to you — not an id you can look up, construct, or correlate with anything. Treat it as a blob."},"statusMessage":{"type":"string","description":"Human-readable description of what the operation is currently doing. Safe to show the user as progress, but it is not a result — never treat it as one."},"pollInterval":{"type":"number","description":"Milliseconds to wait before calling `image_get_task_status` with this `taskId`. Normally 0: `image_get_task_status` blocks while it waits, so there is no reason to sleep first."}},"required":["success"],"additionalProperties":{}}}},"required":["results"],"additionalProperties":false,"description":"Output from MCP tool call"}},{"name":"adobe.interactive_image_get_options_for_adjustments_app","title":"Get Options for Adjustments","description":"Retrieve all available adjustments and their configurable parameters. Call this tool when you need to know what adjustments exist and how to configure them (e.g. parameter names, types, defaults, min/max).\n\n**WHEN TO USE THIS TOOL:**\nCall this tool to get the full list of available adjustments and their configurable parameters before suggesting or applying adjustments.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"_meta":{"resource_name":"adobe.interactive_image_get_options_for_adjustments_app","_codex_apps":{"resource_uri":"/connector_69312da8e4dc81919370cb86fd172b6c/link_6abb1a24e0d88191bee88b0fb41f697e/interactive_image_get_options_for_adjustments_app","contains_mcp_source":true},"connector_id":"connector_69312da8e4dc81919370cb86fd172b6c","connector_name":"Adobe","connector_description":"Design, combine, and edit","link_id":"link_6abb1a24e0d88191bee88b0fb41f697e","link_owner_profile":{}},"outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"error":{"description":"If failed, error message from the tool result.","type":"string"},"input":{"description":"Original input parameters passed to the tool","type":"object","properties":{},"additionalProperties":{}},"metadata":{"description":"Optional metadata related to the tool result(s), will vary depending on the tool.","type":"object","properties":{},"additionalProperties":{}},"originalURI":{"description":"Original input image URI, if applicable.","type":"string"},"outputFile":{"description":"If tool succeeded, the file object for the processed image result.","type":"string"},"outputUrl":{"description":"If tool succeeded, presigned URL for the processed image result.","type":"string"},"outputMediaType":{"description":"If tool succeeded, IANA media type of the