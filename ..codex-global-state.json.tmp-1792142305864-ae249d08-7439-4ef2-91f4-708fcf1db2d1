88191bee88b0fb41f697e","link_owner_profile":{}},"outputSchema":{"type":"object","properties":{"cards":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["inspiration","micro","app"]},"title":{"type":"string"},"subtitle":{"type":"string"},"badge":{"type":"string"},"accent":{"type":"string"},"image":{"type":"string"},"prompt":{"type":"string"},"tool":{"type":"string"},"appId":{"type":"string"},"url":{"type":"string"}},"required":["id","kind","title","subtitle","badge","accent","image"]}},"version":{"type":"string"},"logo":{"type":"string"}},"required":["cards"]}},{"name":"adobe.font_details","title":"Font Details","description":"Look up authoritative Adobe Fonts metadata for one or more fonts — text only,\nno image; this does not show what a font looks like — if a font-preview tool\nis available on this surface, use it instead for a visual specimen (its own\ndocstring links back here for the reverse case).\n\nArgs:\n    font_identifiers: Fonts to look up. Each requires postscript_name; font_id is\n        optional. The lookup has no combined-key mode — it resolves by exactly\n        one identifier per request — so when both are given, font_id is tried\n        first (it's the more precise identifier when valid), and postscript_name\n        is tried as a fallback only if that specific font_id lookup fails. Either\n        one resolving is enough; they are not cross-validated against each other,\n        so if both are given and disagree, the result silently reflects whichever\n        one succeeded — check the returned resolved_via if you need to know which.\n        A malformed postscript_name is only rejected as invalid_input\n        when font_id is absent; when font_id is present, a malformed\n        postscript_name is simply not attempted as a fallback candidate — no\n        error is raised about it specifically, so a failure in that case doesn't\n        distinguish \"font_id failed, postscript_name was fine but didn't match\"\n        from \"font_id failed, postscript_name was malformed and never tried.\"\n        postscript_name must match exactly, including case — this lookup does not\n        fuzzy-match or case-normalize (e.g. \"myriadpro-regular\" will not resolve\n        \"MyriadPro-Regular\"). Use an exact value, such as one already returned by\n        the font-recommendation tool, rather than guessing from a display name.\n    locale: Language the returned font family/style names (and\n        recommendation/search group names) are translated into, when a\n        translation is available (default en_US). Hyphen,\n        bare-code, and region-mismatched forms are all\n        normalized to the closest supported locale (e.g. ja-JP\n        and ja both become ja_JP; en_GB becomes en_US); an\n        unsupported value falls back to en_US rather than being\n        rejected. See this\n        server's MCP instructions for the list of supported locales.\n\nReturns:\n    JSON string with a `results` list, one entry per requested font, in the same\n    order as the input. Each entry is either resolved metadata (family_name,\n    style_name, full_name, designers, foundry, detail_url, preview_url,\n    language_support, library_availability, weight, style, is_variable_font,\n    axes, resolved_via, requested, and a font_identifier or bare postscript_name)\n    or {\"postscript_name\": ..., \"error_code\": \"<code>\", \"user_message\": \"...\",\n    \"requested\": {...}} where error_code is one of invalid_input, not_found,\n    upstream_error, upstream_timeout, and user_message is human-readable text\n    safe to show the caller as-is.\n    weight is the numeric OpenType weight class (e.g. 400, 700); the same\n    class can look visually different across different families. style is\n    \"normal\" or \"italic\". Use these rather than inferring boldness or\n    slant from style_name or postscript_name text.\n    is_variable_font is always present (true/false). axes is present exactly\n    when is_variable_font is true (and only then) -- always a list, though it\n    may be empty ([]) for a variable font that exposes no usable named\n    instances -- a list of axis tags (e.g. [\"wght\", \"wdth\"])\n    this font exposes — tags only, deliberately no min/max/default. This tool has\n    no access to the font's true axis range, so it doesn't claim numeric ranges\n    it can't verify — only that these axes exist.\n    Do not guess at or state a specific min/max/default for an axis from this\n    tool's output.\n    resolved_via is \"font_id\" or \"postscript_name\" — whichever identifier\n    actually produced this result. When only one was supplied it's that one;\n    when both were supplied it tells you which one decided the outcome, since\n    they aren't cross-validated against each other. requested ({postscript_name,\n    font_id — font_id present only if you supplied one}) is always present, on\n    every entry, success or error, echoing exactly what you sent for that entry\n    (not the resolved identity) — use it to match a result back to its request\n    after filtering, reordering, or merging results downstream, rather than\n    relying on array position or re-deriving it from the resolved fields, which\n    only coincidentally match what was requested and don't when font_id\n    resolved to a different font than the postscript_name you sent.\n    font_identifier (rather than a bare postscript_name) appears whenever a\n    font_id could be resolved for that font — including when the input only\n    supplied postscript_name — so a bare-postscript_name lookup doubles as a\n    postscript_name-to-font_id resolver.\n    invalid_input includes a client-side format check against the standard\n    PostScript name character set (letters, digits, \".\", \"_\", \"-\", 1-255 chars)\n    and never reaches the network — retrying with the same value won't help.\n    not_found means the format was fine but no font matched it exactly.\n    language_support lists language codes (BCP 47/IANA subtags, e.g. \"ja\",\n    \"zh-Latn-pinyin\") for which this font's glyph coverage satisfies Adobe's\n    curated minimum-codepoint-set definition of that language (deliberately\n    excluding common punctuation) — not raw font cmap coverage or a marketing\n    claim. A missing code means the font doesn't meet that minimum, not that\n    Adobe Fonts lacks support for the language generally.\n    upstream_error means the lookup itself failed with a hard error.\n    upstream_timeout means the lookup hit a transient failure — a timeout,\n    a connection error, or a 5xx — so retrying may succeed.\n\nIf the user wants to see the font rather than only read about it, and a\nfont-preview tool is available on this surface, pass the returned\nfont_identifier as the one entry in a font_identifiers list to it to\nshow an inline specimen — this tool only returns metadata text, never\na rendered preview. If the\nuser wants other weights, widths, or italics in the same family instead\nof (or in addition to) this exact font, and a font-styles tool is\navailable on this surface, use it instead — this tool only returns the\nsingle font(s) requested, never sibling styles.\n","inputSchema":{"type":"object","properties":{"font_identifiers":{"items":{"$ref":"#/$defs/FontIdentifier"},"title":"Font Identifiers","type":"array"},"locale":{"anyOf":[{"type":"string"},{"type":"null"}],"default":"en_US","title":"Locale"}},"required":["font_identifiers"],"$defs":{"FontIdentifier":{"description":"A font's identity: mandatory postscript_name, optional font_id. Shared\nacross tools that consume this differently -- font_id is tried first in\nget_font_details/get_font_styles/get_font_preview, used to skip a\nresolution hop in add_fonts_to_cc_selections, and accepted but never\nconsumed in create_font_kit or get_similar_fonts (both look up by\npostscript_name alone) -- see each tool's own docstring for which\napplies.","properties":{"postscript_name":{"title":"Postscript Name","type":"string"},"font_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Font Id"}},"required":["postscript_name"],"title":"FontIdentifier","type":"object"}},"title":"get_font_detailsArguments"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false},"_meta":{"resource_name":"adobe.font_details","_codex_apps":{"resource_uri":"/connector_69312da8e4dc81919370cb86fd172b6c/link_6abb1a24e0d88191bee88b0fb41f697e/font_details","contains_mcp_source":true},"connector_id":"connector_69312da8e4dc81919370cb86fd172b6c","connector_name":"Adobe","connector_description":"Design, combine, and edit","link_id":"link_6abb1a24e0d88191bee88b0fb41f697e","link_owner_profile":{}},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"get_font_detailsOutput","type":"object"}},{"name":"adobe.pdf_properties","title":"pdf_properties","description":"Get PDF document info: page count, version, encryption status, and metadata.\n\nWHEN TO USE: \"how many pages\", \"is it encrypted\", \"who is the author\", \"PDF info\".\n\nRead-only - does not modify the file.","inputSchema":{"type":"object","properties":{"include_page_level_properties":{"default":false,"description":"Whether to include detailed page-level properties. True: returns info about each page (dimensions, rotation, content). False: returns only document-level properties (page count, version, encryption).","title":"Include Page Level Properties","type":"boolean"},"asset_url_or_urn":{"type":"string","description":"PDF file to process. Pass a URL/URN string starting with \"https://\" or \"urn:\". Local file paths are not supported.","title":"Asset Url Or Urn","examples":["https://example.com/file.pdf","urn:aaid:sc:AP:a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d"]}},"required":["asset_url_or_urn"],"title":"PDFPropertiesInput"},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false},"_meta":{